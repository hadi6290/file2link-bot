# این فایل فقط جنبه مستندسازی دارد.
# در دنیای واقعی، این مقادیر با دستور زیر روی Cloudflare Worker ست می‌شوند
# (نه با فایل .env، چون Workers از فایل .env پشتیبانی نمی‌کند):
#
#   npx wrangler secret put BOT_TOKEN
#   npx wrangler secret put WEBHOOK_SECRET
#
# برای اجرای محلی (wrangler dev) از worker/.dev.vars استفاده کن
# (نمونه آن: worker/.dev.vars.example)

# توکنی که BotFather بعد از ساخت ربات به شما می‌دهد
BOT_TOKEN=1234567890:AAExampleTokenFromBotFather

# رشته دلخواه و تصادفی برای تایید امنیتی درخواست‌های Webhook
WEBHOOK_SECRET=a-random-long-secret-string-you-choose

# آدرس نهایی Worker بعد از دیپلوی، مثلاً:
# https://file2link-bot.YOUR-SUBDOMAIN.workers.dev
WORKER_BASE_URL=https://file2link-bot.your-subdomain.workers.dev
